<Slide style={{ padding: 0, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ width: '100%', height: 76, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 6, height: 34, background: '#FFC107' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>训练策略与超参数</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#8FC0F0' }}>02 技术路线与数据处理</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 26, paddingTop: 22, paddingLeft: 40, paddingRight: 40, paddingBottom: 22 }}>
        <Box style={{ width: 330, gap: 14 }}>
            <Box style={{ background: '#0E3F8C', borderRadius: 10, padding: 20, gap: 8 }}>
                <Text style={{ fontSize: 25, fontWeight: 'bold', color: '#FFFFFF' }}>统一的训练协议</Text>
                <Text style={{ fontSize: 17, color: '#CFE0F7', lineHeight: 1.6 }}>
                    六个模型共用这一套超参，任何差异都来自架构本身。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 18, gap: 6, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, color: '#4A5568' }}>训练轮数上限</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>50</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568' }}>epoch</Text>
                </Box>
                <Box style={{ height: 1, background: '#D6DCE5', marginTop: 8, marginBottom: 8 }} />
                <Text style={{ fontSize: 18, color: '#4A5568' }}>早停耐心值</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
                    <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>15</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568' }}>epoch</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#8B97A8', lineHeight: 1.5, marginTop: 6 }}>
                    连续 15 轮验证集 macro-F1 不提升即停止，并回滚到历史最优权重。
                </Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, gap: 12 }}>
            <Table
                style={{ width: '100%', height: 430 }}
                defaultTextStyle={{ fontSize: 18, textAlign: 'left', color: '#1A2230' }}
                defaultCellStyle={{
                    paddingLeft: 18,
                    border: {
                        left: { width: 1, color: '#D6DCE5' }, right: { width: 1, color: '#D6DCE5' },
                        top: { width: 1, color: '#D6DCE5' }, bottom: { width: 1, color: '#D6DCE5' },
                    },
                }}
                cells={[
                    [
                        { text: '项目', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '取值', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '为什么这么设', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    ],
                    [
                        { text: '输入尺寸', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '224 × 224 × 3', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '对齐 ImageNet 预训练分辨率', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        'Batch Size', '32', '显存占用与梯度稳定性的折中',
                    ],
                    [
                        { text: '优化器', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: 'AdamW', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '把权重衰减从梯度更新中解耦，泛化更好', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '学习率', 'ResNet 3e-4 / 预训练 ViT 1e-4', 'ViT 在 3e-4 下训练不稳定，需更小的步长',
                    ],
                    [
                        { text: '权重衰减', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '1e-4', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '抑制 11M～86M 参数的过拟合', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '学习率调度', 'StepLR(step=15, γ=0.1)', '每 15 轮降一个数量级，后期细调',
                    ],
                    [
                        { text: '损失函数', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '类别加权交叉熵', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '抵消 437 : 210 : 133 的类别倾斜', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '标签平滑', 'ε = 0.1', '防止模型对训练样本过度自信',
                    ],
                    [
                        { text: '初始化', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: 'ImageNet-1K 预训练权重', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '把自然图像的底层特征迁移到超声', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '随机种子', '42', '保证划分与初始化可复现',
                    ],
                ]}
            />
            <Box style={{ height: 74, background: '#FFF8E1', borderLeft: '5px solid #FFC107', borderRadius: 6, paddingLeft: 16, paddingRight: 14, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.5 }}>
                    <span style={{ fontWeight: 'bold' }}>判断：</span>小数据训练里，早停比多训几轮更重要——本实验 ResNet50 跑满 49 轮、ResNet18 在第 44 轮停、ViT-B/16 第 32 轮就触发早停，说明容量越大的模型越早撞上过拟合墙。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40, borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>BUSI 乳腺超声图像分类 · 乳腺癌智能诊断</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>10 / 38</Text>
    </Box>
</Slide>
