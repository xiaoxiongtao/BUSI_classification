<Slide style={{ padding: 0, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ width: '100%', height: 76, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 6, height: 34, background: '#FFC107' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>代码实现与迁移学习</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#8FC0F0' }}>03 ResNet：深度残差网络</Text>
    </Box>

    <Box style={{ height: 604, flexDirection: 'row', gap: 24, paddingTop: 20, paddingLeft: 40, paddingRight: 40, paddingBottom: 20 }}>
        <Box style={{ width: 356, gap: 12 }}>
            <Box style={{ background: '#0E3F8C', borderRadius: 10, padding: 18, gap: 8 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>迁移学习：小数据的救命稻草</Text>
                <Text style={{ fontSize: 17, color: '#CFE0F7', lineHeight: 1.6 }}>
                    546 张训练图不可能从头训出可靠的卷积核。加载 ImageNet 预训练权重，让模型复用已经学好的边缘、纹理与形状检测器。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 16, gap: 10 }}>
                <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C' }}>三步迁移</Text>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: 32, height: 32, background: '#1E4FA8', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                        载入 torchvision 的 ImageNet 权重
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: 32, height: 32, background: '#1E4FA8', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                        弹出 fc.weight / fc.bias（1000 类不适用）
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 10, alignItems: 'flex-start' }}>
                    <Box style={{ width: 32, height: 32, background: '#1E4FA8', borderRadius: 16, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                    </Box>
                    <Text style={{ flex: 1, fontSize: 17, color: '#4A5568', lineHeight: 1.55 }}>
                        换上新的 512 → 3 分类头，随机初始化后训练
                    </Text>
                </Box>
                <Box style={{ background: '#FFF8E1', borderRadius: 6, padding: 10, marginTop: 'auto' }}>
                    <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>
                        <span style={{ fontWeight: 'bold' }}>提醒：</span>strict=False 是关键，它容忍分类头形状不匹配。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flex: 1, gap: 12 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#E8EFF8', borderRadius: 8, paddingLeft: 16, paddingTop: 9, paddingBottom: 9 }}>
                <FAIcon name='info-circle' style={{ fill: '#1E4FA8', width: 24, height: 24 }} />
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>核心代码只有十几行，但每一行都有讲究</Text>
            </Box>

            <CodeBlock
                code={`# 1) 残差块的前向：先卷积，再相加，最后激活
class BasicBlock(nn.Module):
    def forward(self, x):
        identity = x                    # 保住原始输入
        out = self.relu(self.bn1(self.conv1(x)))
        out = self.bn2(self.conv2(out))
        if self.downsample is not None: # 尺寸/通道不一致时投影
            identity = self.downsample(x)
        out += identity                 # ← 就是这一行
        return self.relu(out)

# 2) 载入 ImageNet 预训练权重，只替换分类头
from torchvision import models as tv_models
w = tv_models.ResNet18_Weights.IMAGENET1K_V1
state = tv_models.resnet18(weights=w).state_dict()
state.pop("fc.weight"); state.pop("fc.bias")
model.load_state_dict(state, strict=False)
model.fc = nn.Linear(512, num_classes)  # 512 -> 3`}
                language='python'
                width={800}
                fontSize={12}
                theme='github-light'
            />

            <Box style={{ flex: 1, background: '#FFFFFF', border: '1px solid #D6DCE5', borderLeft: '5px solid #FFC107', borderRadius: 8, padding: 14, gap: 6 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>迁移带来的实际收益</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6 }}>
                    预训练权重把"看见了什么"的通用能力带进来，模型只需专注学习"超声图像上的良恶性差别"。这也是本项目所有 ResNet 与 ViT 都默认开启预训练的原因。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40, borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>BUSI 乳腺超声图像分类 · 乳腺癌智能诊断</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>16 / 38</Text>
    </Box>
</Slide>
