<Slide style={{ padding: 0, background: '#FFFFFF', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ width: '100%', height: 76, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 6, height: 34, background: '#FFC107' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>实验设置：先保证可比，再谈优劣</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#8FC0F0' }}>06 实验结果与分析</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'row', gap: 24, paddingTop: 20, paddingLeft: 40, paddingRight: 40, paddingBottom: 20 }}>
        <Box style={{ width: 350, gap: 12 }}>
            <Box style={{ background: '#0E3F8C', borderRadius: 10, padding: 18, gap: 6 }}>
                <Text style={{ fontSize: 23, fontWeight: 'bold', color: '#FFFFFF' }}>一份数据，三次划分</Text>
                <Text style={{ fontSize: 17, color: '#CFE0F7', lineHeight: 1.6 }}>
                    按类别分层抽样，随机种子固定为 42。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 16, gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 18, color: '#4A5568' }}>训练集</Text>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1E4FA8' }}>544 张</Text>
                </Box>
                <Box style={{ height: 1, background: '#D6DCE5' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 18, color: '#4A5568' }}>验证集</Text>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1E4FA8' }}>118 张</Text>
                </Box>
                <Box style={{ height: 1, background: '#D6DCE5' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'baseline', justifyContent: 'space-between' }}>
                    <Text style={{ fontSize: 18, color: '#4A5568' }}>测试集</Text>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#1E4FA8' }}>118 张</Text>
                </Box>
                <Box style={{ height: 1, background: '#D6DCE5' }} />
                <Text style={{ fontSize: 17, color: '#4A5568', lineHeight: 1.6 }}>
                    验证集用于选最优权重与早停；测试集全程不参与任何调参，只在训练结束后评估一次。
                </Text>
                <Box style={{ background: '#FFF8E1', borderRadius: 6, padding: 10, marginTop: 'auto' }}>
                    <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.5 }}>
                        三个类别在各子集中的比例与全集保持一致。
                    </Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flex: 1, gap: 12 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#E8EFF8', borderRadius: 8, paddingLeft: 16, paddingTop: 9, paddingBottom: 9 }}>
                <FAIcon name='info-circle' style={{ fill: '#1E4FA8', width: 24, height: 24 }} />
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>对照实验的设计原则：一次只改一个变量</Text>
            </Box>

            <Table
                style={{ width: '100%', height: 366 }}
                defaultTextStyle={{ fontSize: 17, textAlign: 'left', color: '#1A2230' }}
                defaultCellStyle={{
                    paddingLeft: 16,
                    border: {
                        left: { width: 1, color: '#D6DCE5' }, right: { width: 1, color: '#D6DCE5' },
                        top: { width: 1, color: '#D6DCE5' }, bottom: { width: 1, color: '#D6DCE5' },
                    },
                }}
                cells={[
                    [
                        { text: '实验要素', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '设置', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#0E3F8C' } } },
                        { text: '两模型是否一致', textStyle: { bold: true, color: '#FFFFFF', fontSize: 18 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    ],
                    [
                        { text: '数据划分', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '分层抽样 70 / 15 / 15，seed = 42', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '✔ 完全一致', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '数据增强', '随机裁剪 + 翻转 + 旋转 + 色彩抖动', '✔ 完全一致',
                    ],
                    [
                        { text: '输入分辨率', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '224 × 224，ImageNet 归一化', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '✔ 完全一致', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '批量与轮数', 'batch 32，最多 50 epoch，早停 15', '✔ 完全一致',
                    ],
                    [
                        { text: '损失函数', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '类别加权交叉熵（同一份权重）', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '✔ 完全一致', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        '优化与调度', 'AdamW + StepLR(15, 0.1)', '✔ 完全一致',
                    ],
                    [
                        { text: '初始化', textStyle: { bold: true }, cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '均加载 ImageNet-1K 预训练权重', cellStyle: { background: { color: '#F0F5FC' } } },
                        { text: '✔ 完全一致', cellStyle: { background: { color: '#F0F5FC' } } },
                    ],
                    [
                        { text: '唯一变量', textStyle: { bold: true, color: '#D9534F' }, cellStyle: { background: { color: '#FFF8E1' } } },
                        { text: '网络结构：ResNet-18/34/50/101 与 ViT-B/16、轻量 ViT', cellStyle: { background: { color: '#FFF8E1' } } },
                        { text: '✘ 这是要比较的对象', textStyle: { bold: true, color: '#D9534F' }, cellStyle: { background: { color: '#FFF8E1' } } },
                    ],
                ]}
            />

            <Box style={{ flex: 1, background: '#FFF8E1', borderLeft: '5px solid #FFC107', borderRadius: 8, padding: 14, justifyContent: 'center' }}>
                <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.55 }}>
                    <span style={{ fontWeight: 'bold' }}>判断：</span>六个模型跑在同一套流程上，成绩差异可以直接归因于架构。另外要注意：测试集只有 118 张，单个百分点的波动可能来自 1～2 张图，因此看趋势比看绝对值更重要。
                </Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 40, paddingRight: 40, borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>BUSI 乳腺超声图像分类 · 乳腺癌智能诊断</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>28 / 38</Text>
    </Box>
</Slide>
